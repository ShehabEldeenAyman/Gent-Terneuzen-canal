# MLDCAT-AP 3.1 metadata for the LSTM experiments in
# time_series_analysis/LSTM_TCN_72h_vs_manual_42h.ipynb.
#
# The notebook currently contains the trained-run results and reproducible model
# definitions, but it does not export serialized weights. Consequently, the
# mandatory it6:hasFile link identifies the notebook implementation and does not
# claim that a deployable .keras, SavedModel, ONNX, or TensorFlow.js file exists.


# -----------------------------------------------------------------------------
# LSTM model trained with the unrestricted 72-hour input representation
# -----------------------------------------------------------------------------

gtc:lstm-unrestricted-72h
    a it6:MachineLearningModel ;
    dct:title "LSTM 72-hour Indusii conductivity forecaster — unrestricted input"@en ;
    dct:identifier "gtc-lstm-unrestricted-72h-v1" ;
    dct:created "2026-08-26"^^xsd:date ;
    dct:modified "2026-08-28"^^xsd:date ;
    dct:creator <https://github.com/ShehabEldeenAyman> ;
    dct:license <https://opensource.org/license/mit> ;
    dct:type gtc:MultivariateTimeSeriesForecasting ;
    dcat:version "1.0.0" ;
    dcat:keyword "LSTM", "conductivity", "salinity intrusion", "time-series forecasting", "72-hour forecast", "Gent-Terneuzen Canal" ;
    it6:hasFile gtc:lstm-tcn-notebook ;
    it6:hasRepository <https://github.com/ShehabEldeenAyman/Gent-Terneuzen-canal> ;
    it6:hasUploader <https://github.com/ShehabEldeenAyman> ;
    it6:trainedOn gtc:unrestricted-72h-training-data ;
    it6:validatedOn gtc:unrestricted-72h-validation-data ;
    it6:testedOn gtc:unrestricted-72h-test-data ;
    it6:releaseDate "2026-08-28"^^xsd:date ;
    it6:shortDescription "A stacked LSTM that forecasts 288 consecutive 15-minute conductivity values at Indusii from 72 hours of observations at five canal sensors."@en ;
    dct:description "The selected unrestricted-input LSTM candidate is LSTM-128x64. It consumes a 288 by 5 standardized multivariate sequence and predicts the next 288 Indusii values as residuals relative to the latest target observation."@en ;
    it6:modelArchitecture "Two stacked LSTM layers with 128 and 64 units, return_sequences enabled, dropout and layer normalization. Last-step, temporal-mean, temporal-maximum and latest-target summaries feed a 128-unit Swish dense head and a 288-value residual output. Total trainable parameters: 180,640."@en ;
    it6:totalNumberOfParameters "180640"^^xsd:nonNegativeInteger ;
    it6:designSpecifications "Input shape: 288 time steps by 5 sensors (Terneuzen, Westdorpe, Gent-far, Gent-near and Indusii). Output shape: 288 steps at 15-minute resolution, corresponding to a 72-hour forecast. The training objective is mean squared error."@en ;
    it6:trainingMethodologies "Supervised direct multi-horizon regression with chronological splits, causal trailing two-hour smoothing, limited internal interpolation, training-only standardization, AdamW optimization and residual prediction."@en ;
    it6:trainingProcess "The notebook's quick search compares two predeclared LSTM candidates using August only. This LSTM-128x64 candidate uses learning rate 0.0002, weight decay 0.00002, dropout 0.20 and batch size 64. Training permits up to 100 epochs with gradient clipping, ReduceLROnPlateau and early stopping with patience 12 and best-weight restoration. The recorded run stopped after 60 epochs and restored epoch 48; fit time was 917.3 seconds on the execution machine."@en ;
    it6:evaluationStrategies "Candidate selection and optional per-lead calibration use the August 2025 validation split only. September 2025 is held out until selection. Performance is compared with a persistence forecast using RMSE and skill, where skill equals one minus model RMSE divided by persistence RMSE."@en ;
    it6:evaluationResults "August validation RMSE was 0.27070, versus persistence RMSE 0.31953 (skill 0.153). With the August calibration selected by the notebook, held-out September RMSE was 0.30554 and overall 72-hour skill was 0.0924."@en ;
    it6:intendedUse "Research comparison of causal neural forecasting approaches for 72-hour conductivity forecasting at the Indusii station on the Gent-Terneuzen Canal."@en ;
    it6:howToUse "Open and run time_series_analysis/LSTM_TCN_72h_vs_manual_42h.ipynb with a reachable Fuseki dataset. The notebook reconstructs and trains the model. It does not currently save trained weights, so inference in a later session requires retraining or adding an explicit model export step."@en ;
    it6:limitations "Validated only on the stated 2025 canal observations and sensor configuration. It is not a safety-critical warning system. Accuracy can deteriorate under missing sensors, distribution shift or other waterways. The experiment has no committed serialized weights, and the recorded September result was worse than the manual-input TCN variant."@en .


# -----------------------------------------------------------------------------
# LSTM model trained with the manual 42-hour input representation
# -----------------------------------------------------------------------------

gtc:lstm-manual-42h
    a it6:MachineLearningModel ;
    dct:title "LSTM 72-hour Indusii conductivity forecaster — manual 42-hour input"@en ;
    dct:identifier "gtc-lstm-manual-42h-v1" ;
    dct:created "2026-08-26"^^xsd:date ;
    dct:modified "2026-08-28"^^xsd:date ;
    dct:creator <https://github.com/ShehabEldeenAyman> ;
    dct:license <https://opensource.org/license/mit> ;
    dct:type gtc:MultivariateTimeSeriesForecasting ;
    dcat:version "1.0.0" ;
    dcat:keyword "LSTM", "conductivity", "salinity intrusion", "time-series forecasting", "manual lag selection", "72-hour forecast", "Gent-Terneuzen Canal" ;
    it6:hasFile gtc:lstm-tcn-notebook ;
    it6:hasRepository <https://github.com/ShehabEldeenAyman/Gent-Terneuzen-canal> ;
    it6:hasUploader <https://github.com/ShehabEldeenAyman> ;
    it6:trainedOn gtc:manual-42h-training-data ;
    it6:validatedOn gtc:manual-42h-validation-data ;
    it6:testedOn gtc:manual-42h-test-data ;
    it6:releaseDate "2026-08-28"^^xsd:date ;
    it6:shortDescription "A stacked LSTM that forecasts 288 consecutive 15-minute conductivity values at Indusii from a 42-hour, four-feature manual representation."@en ;
    dct:description "The selected manual-input LSTM candidate is LSTM-96x48. It consumes a 168 by 4 standardized engineered sequence and predicts the next 288 Indusii values as residuals relative to the latest target observation."@en ;
    it6:modelArchitecture "Two stacked LSTM layers with 96 and 48 units, return_sequences enabled, dropout and layer normalization. Last-step, temporal-mean, temporal-maximum and latest-target summaries feed a 96-unit Swish dense head and a 288-value residual output. Total trainable parameters: 108,960."@en ;
    it6:totalNumberOfParameters "108960"^^xsd:nonNegativeInteger ;
    it6:designSpecifications "Input shape: 168 time steps by 4 manually engineered conductivity features. Output shape: 288 steps at 15-minute resolution, corresponding to a 72-hour forecast. The training objective is mean squared error."@en ;
    it6:trainingMethodologies "Supervised direct multi-horizon regression with chronological splits, causal trailing two-hour smoothing, limited internal interpolation, training-only standardization, AdamW optimization and residual prediction."@en ;
    it6:trainingProcess "The notebook's quick search compares two predeclared LSTM candidates using August only. This LSTM-96x48 candidate uses learning rate 0.0003, weight decay 0.00001, dropout 0.15 and batch size 64. Training permits up to 100 epochs with gradient clipping, ReduceLROnPlateau and early stopping with patience 12 and best-weight restoration. The recorded run stopped after 28 epochs and restored epoch 16; fit time was 191.4 seconds on the execution machine."@en ;
    it6:evaluationStrategies "Candidate selection and optional per-lead calibration use the August 2025 validation split only. September 2025 is held out until selection. Performance is compared with a persistence forecast using RMSE and skill, where skill equals one minus model RMSE divided by persistence RMSE."@en ;
    it6:evaluationResults "August validation RMSE was 0.26018, versus persistence RMSE 0.31953 (skill 0.186). With the August calibration selected by the notebook, held-out September RMSE was 0.28385 and overall 72-hour skill was 0.1568."@en ;
    it6:intendedUse "Research comparison of causal neural forecasting approaches for 72-hour conductivity forecasting at the Indusii station on the Gent-Terneuzen Canal."@en ;
    it6:howToUse "Open and run time_series_analysis/LSTM_TCN_72h_vs_manual_42h.ipynb with a reachable Fuseki dataset. The notebook reconstructs and trains the model. It does not currently save trained weights, so inference in a later session requires retraining or adding an explicit model export step."@en ;
    it6:limitations "Validated only on the stated 2025 canal observations and sensor configuration. It is not a safety-critical warning system. Accuracy can deteriorate under missing sensors, distribution shift or other waterways. The experiment has no committed serialized weights."@en .


