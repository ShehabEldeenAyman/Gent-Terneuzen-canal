# -----------------------------------------------------------------------------
# Chronological datasets used by the TCN variants
# -----------------------------------------------------------------------------

gtc:unrestricted-72h-training-data
    a dcat:Dataset ;
    dct:title "Unrestricted 72-hour representation — training split"@en ;
    dct:description "3,740 causal supervised samples with input shape 288 by 5 and target shape 288. Sample endpoints run from 2025-01-07T13:45:00Z through 2025-07-31T23:45:00Z."@en ;
    it6:collectionDate "2025-01-07"^^xsd:date .

gtc:unrestricted-72h-validation-data
    a dcat:Dataset ;
    dct:title "Unrestricted 72-hour representation — validation split"@en ;
    dct:description "2,098 causal supervised samples with input shape 288 by 5 and target shape 288. Sample endpoints run from 2025-08-10T03:30:00Z through 2025-08-31T23:45:00Z."@en ;
    it6:collectionDate "2025-08-10"^^xsd:date .

gtc:unrestricted-72h-test-data
    a dcat:Dataset ;
    dct:title "Unrestricted 72-hour representation — held-out test split"@en ;
    dct:description "2,593 causal supervised samples with input shape 288 by 5 and target shape 288. Sample endpoints run from 2025-09-03T23:45:00Z through 2025-09-30T23:45:00Z."@en ;
    it6:collectionDate "2025-09-03"^^xsd:date .

gtc:manual-42h-training-data
    a dcat:Dataset ;
    dct:title "Manual 42-hour representation — training split"@en ;
    dct:description "3,740 causal supervised samples with input shape 168 by 4 and target shape 288. Sample endpoints run from 2025-01-07T13:45:00Z through 2025-07-31T23:45:00Z."@en ;
    it6:collectionDate "2025-01-07"^^xsd:date .

gtc:manual-42h-validation-data
    a dcat:Dataset ;
    dct:title "Manual 42-hour representation — validation split"@en ;
    dct:description "2,098 causal supervised samples with input shape 168 by 4 and target shape 288. Sample endpoints run from 2025-08-10T03:30:00Z through 2025-08-31T23:45:00Z."@en ;
    it6:collectionDate "2025-08-10"^^xsd:date .

gtc:manual-42h-test-data
    a dcat:Dataset ;
    dct:title "Manual 42-hour representation — held-out test split"@en ;
    dct:description "2,593 causal supervised samples with input shape 168 by 4 and target shape 288. Sample endpoints run from 2025-09-03T23:45:00Z through 2025-09-30T23:45:00Z."@en ;
    it6:collectionDate "2025-09-03"^^xsd:date .
