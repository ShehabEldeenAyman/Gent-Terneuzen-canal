# REPOSITORY
# ─────────────────────────────────────────────────────────────────────────────

<https://shehabeldeenayman.github.io/Gent-Terneuzen-canal/tree/main>
    a lpwc:repository ;
    MLDCAT:hasFile
        <https://shehabeldeenayman.github.io/Gent-Terneuzen-canal/model.json> .


